# Root environment template — dev EC2 + RDS
#
# Used by:
#   - docker-compose.rds.yml  (cp to .env on EC2)
#   - scripts/check-env-pairing.sh
#
# For EC2 systemd deploy, prefer:
#   deploy/env/application.env.example → /opt/gamya-couture/config/application.env
#
# For local laptop dev:
#   docker compose up -d          (Postgres — no .env needed)
#   mvn spring-boot:run -Dspring-boot.run.profiles=local
#
# For frontend:
#   frontend/.env.local.example → frontend/.env.local

# --- Database (RDS dev) ---
DB_URL=jdbc:postgresql://gamya-couture-dev-pg.c8xkhvlstsfp.ap-south-1.rds.amazonaws.com:5432/gamya
DB_USER=gamya_admin
DB_PASSWORD=changeme

# --- Spring ---
SPRING_PROFILES_ACTIVE=dev
JWT_SECRET=changeme-min-32-characters-required!!
CORS_ALLOWED_ORIGINS=https://gamyaboutique.vercel.app,http://localhost:3000

# --- S3 media ---
APP_STORAGE_S3_ENABLED=true
APP_STORAGE_S3_BUCKET=gamya-couture-dev-media
APP_STORAGE_S3_REGION=ap-south-1
APP_STORAGE_S3_PUBLIC_BASE_URL=https://d2568bpd35bq6a.cloudfront.net
APP_STORAGE_S3_KEY_PREFIX=products/

# --- Docker compose (optional) ---
IMAGE_TAG=latest
API_PUBLIC_URL=http://<EC2_PUBLIC_IP>
