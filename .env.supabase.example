# Supabase local / CI environment for Gamya Couture backend
# Usage:
#   set -a && source .env.supabase && set +a
#   mvn spring-boot:run -Dspring-boot.run.profiles=supabase
#
# Copy to .env.supabase (gitignored) and fill DB_PASSWORD from:
#   https://supabase.com/dashboard/project/nlntrftvzcwtrdenufoi/settings/database

DB_PROVIDER=supabase
DB_URL=jdbc:postgresql://db.nlntrftvzcwtrdenufoi.supabase.co:5432/postgres?sslmode=require
DB_USER=postgres
DB_PASSWORD=

SPRING_PROFILES_ACTIVE=supabase
JWT_SECRET=local-dev-jwt-secret-key-min-32-chars!!
CORS_ALLOWED_ORIGINS=http://localhost:3000

SUPABASE_URL=https://nlntrftvzcwtrdenufoi.supabase.co
SUPABASE_PUBLISHABLE_KEY=
