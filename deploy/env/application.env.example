# Runtime config for gamya-couture-backend (systemd EnvironmentFile).
# Copy to /opt/gamya-couture/config/application.env on EC2 and fill in secrets.
# File mode: 640, owner root:gamya

SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

DB_URL=jdbc:postgresql://127.0.0.1:5432/gamya_couture
DB_USER=gamya
DB_PASSWORD=change-me-strong-password

JWT_SECRET=change-me-use-openssl-rand-base64-32
JWT_ACCESS_EXPIRATION_MS=3600000

# Must include your Vercel storefront origin (pairs with frontend NEXT_PUBLIC_SITE_URL)
CORS_ALLOWED_ORIGINS=https://gamyacouture.vercel.app,http://localhost:3000
