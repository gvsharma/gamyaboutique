# Runtime config for gamya-couture-backend (systemd EnvironmentFile).
# Copy to /opt/gamya-couture/config/application.env on EC2.
# File mode: 640, owner root:gamya
#
# Preferred DB: Supabase (see application.supabase.env.example).
# Legacy: RDS — keep SPRING_PROFILES_ACTIVE=dev and RDS DB_* below.

DB_PROVIDER=supabase
SPRING_PROFILES_ACTIVE=supabase
SERVER_PORT=8080

# --- Supabase PostgreSQL (primary) ---
# Password: Dashboard → Project Settings → Database
# Optional SSM (password only): /gamya-couture/dev/supabase/db/password
DB_URL=jdbc:postgresql://db.nlntrftvzcwtrdenufoi.supabase.co:5432/postgres?sslmode=require
DB_USER=postgres
DB_PASSWORD=<from-supabase-dashboard>
DB_POOL_SIZE=5

# --- Legacy RDS (only if DB_PROVIDER=rds and SPRING_PROFILES_ACTIVE=dev) ---
# DB_PROVIDER=rds
# SPRING_PROFILES_ACTIVE=dev
# DB_URL=jdbc:postgresql://gamya-couture-dev-pg.c8xkhvlstsfp.ap-south-1.rds.amazonaws.com:5432/gamya
# DB_USER=gamya_admin
# DB_PASSWORD=gamyaadmin

# JWT (replace in production) — custom Spring JWT; not Supabase Auth
JWT_SECRET=gamya-dev-jwt-secret-key-min-32-chars!!
JWT_ACCESS_EXPIRATION_MS=3600000

# CORS — Vercel storefront + local dev
CORS_ALLOWED_ORIGINS=https://gamyaboutique.vercel.app,http://localhost:3000

# Password reset email (cheapest MVP: Gmail app password or SendGrid free tier)
# Set MAIL_ENABLED=true once credentials are ready; forgot-password is a no-op when false.
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@yourdomain.com
APP_FRONTEND_URL=https://gamyaboutique.vercel.app

# S3 product images (EC2 instance role needs s3:PutObject on the bucket)
APP_STORAGE_S3_ENABLED=true
APP_STORAGE_S3_BUCKET=gamya-couture-dev-media
APP_STORAGE_S3_REGION=ap-south-1
APP_STORAGE_S3_PUBLIC_BASE_URL=https://d2568bpd35bq6a.cloudfront.net
APP_STORAGE_S3_KEY_PREFIX=products/
