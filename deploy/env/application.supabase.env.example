# Supabase runtime config for gamya-couture-backend (systemd EnvironmentFile).
# Copy to /opt/gamya-couture/config/application.env on EC2 (or merge keys into it).
# File mode: 640, owner root:gamya
#
# Dashboard: https://supabase.com/dashboard/project/nlntrftvzcwtrdenufoi
# API URL:    https://nlntrftvzcwtrdenufoi.supabase.co
#
# After switching, confirm deploy scripts leave this file alone:
#   DB_PROVIDER=supabase  (or SPRING_PROFILES_ACTIVE=supabase / DB_URL containing supabase.co)
# Optional SSM for password only (not RDS overwrite):
#   /gamya-couture/dev/supabase/db/password

DB_PROVIDER=supabase
SPRING_PROFILES_ACTIVE=supabase
SERVER_PORT=8080

# Direct Postgres (works when the host can reach Supabase IPv6/IPv4).
# On IPv4-only EC2, prefer Session pooler from Dashboard → Connect → JDBC.
DB_URL=jdbc:postgresql://db.nlntrftvzcwtrdenufoi.supabase.co:5432/postgres?sslmode=require
DB_USER=postgres
DB_PASSWORD=<from-supabase-dashboard-database-settings>
DB_POOL_SIZE=5

# JWT — use a strong secret in production (custom Spring JWT; not Supabase Auth yet)
JWT_SECRET=change-me-in-production-use-at-least-256-bits-secret-key-here
JWT_ACCESS_EXPIRATION_MS=1800000

# CORS
CORS_ALLOWED_ORIGINS=https://gamyaboutique.vercel.app,http://localhost:3000

# Optional: Supabase client keys (future Next.js direct reads via supabase-js)
SUPABASE_URL=https://nlntrftvzcwtrdenufoi.supabase.co
SUPABASE_PUBLISHABLE_KEY=<from-supabase-dashboard-api-settings>
# NEVER expose service_role / secret key in frontend or committed files

# Mail / S3 — same as other profiles
MAIL_ENABLED=false
APP_FRONTEND_URL=https://gamyaboutique.vercel.app
APP_STORAGE_S3_ENABLED=true
APP_STORAGE_S3_BUCKET=gamya-couture-dev-media
APP_STORAGE_S3_REGION=ap-south-1
APP_STORAGE_S3_PUBLIC_BASE_URL=https://d2568bpd35bq6a.cloudfront.net
APP_STORAGE_S3_KEY_PREFIX=products/
