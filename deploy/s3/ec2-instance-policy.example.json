{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "UploadProductImages",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::gamya-couture-dev-media/products/*"
    },
    {
      "Sid": "ListBucket",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::gamya-couture-dev-media",
      "Condition": {
        "StringLike": {
          "s3:prefix": ["products/*"]
        }
      }
    }
  ]
}
