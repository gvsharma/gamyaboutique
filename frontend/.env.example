# Pair with backend `.env` on EC2 (see repo root `.env.prod.example`).

# --- Local (Spring Boot on localhost) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Vercel + dev EC2 (set both on Vercel Production) ---
# NEXT_PUBLIC_API_BASE_URL=/api/v1
# API_PROXY_TARGET=http://13.232.200.243
# NEXT_PUBLIC_SITE_URL=https://gamyacouture.vercel.app
#
# Backend EC2 .env must set:
#   CORS_ALLOWED_ORIGINS=https://gamyacouture.vercel.app,http://localhost:3000

# --- Future HTTPS API ---
# NEXT_PUBLIC_API_BASE_URL=https://api.your-domain.com/api/v1
# NEXT_PUBLIC_SITE_URL=https://gamyacouture.vercel.app
