# Dev EC2 — pair with frontend Vercel env vars (see frontend/.env.example).
# Copy to .env on EC2: cp .env.prod.example .env

POSTGRES_DB=gamya_couture
DB_USER=gamya
DB_PASSWORD=change-me-strong-password

# At least 256 bits / 32+ chars for HS256
JWT_SECRET=change-me-use-openssl-rand-base64-32

# Must match NEXT_PUBLIC_SITE_URL origin(s). Required for login from browser if API is called directly.
CORS_ALLOWED_ORIGINS=https://gamyacouture.vercel.app,http://localhost:3000

SPRING_PROFILES_ACTIVE=dev
IMAGE_TAG=latest

# EC2 Elastic IP — used by frontend API_PROXY_TARGET (not read by Spring Boot)
# API_PUBLIC_URL=http://13.232.200.243
